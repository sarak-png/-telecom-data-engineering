# Reference only: this file is NOT automatically loaded. Set process environment
# variables in your terminal or secret manager. Never commit actual credentials.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_DATABASE=TELECOM_DB
# Current object/column mapping lives in config/warehouse_contract.json.
# The historical Python RAW/OPS executor requires a separately reviewed adapter.
# Connection settings alone do not adapt its metadata-dependent SQL.
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# For password auth use authenticator=snowflake and set SNOWFLAKE_PASSWORD.
# If your user already has password/MFA configured, use username_password_mfa.
# Prefer: python -m telecom_pipeline.auth_check --prompt-password
# This prompts only inside YOUR terminal, never chat or command arguments.
# Google/Microsoft sign-in: OAUTH_AUTHORIZATION_CODE with an existing
# non-privileged role (e.g. SYSADMIN if granted), NOT ACCOUNTADMIN.
# Uses built-in LOCAL_APPLICATION with PKCE and token caching disabled.
# For key-pair auth use authenticator=SNOWFLAKE_JWT and set:
# SNOWFLAKE_PRIVATE_KEY_FILE=<absolute path outside this repository>
# SNOWFLAKE_PRIVATE_KEY_PASSWORD=<optional encrypted-key passphrase>
